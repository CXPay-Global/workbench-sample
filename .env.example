# Copy to .env and fill in. Server only; never commit .env.

# Your TEST API key ID (ak_test_…) and its Base64 signing secret.
# Scopes used: payments:read, payments:capture, payments:cancel, payments:refund,
# payment_links:read, payment_links:create, payment_links:update.
CXPAY_KEY_ID=ak_test_REPLACE_ME
CXPAY_API_SECRET=REPLACE_WITH_BASE64_SIGNING_SECRET

# Your HTTPS tunnel origin, no trailing slash. The return URL and webhook URL
# you send to CX Pay are built from it.
CXPAY_PUBLIC_ORIGIN=https://your-tunnel.example

# The webhook signing secret (whsec_…) CX Pay sends after registering your
# webhook URL. Leave empty until then.
CXPAY_WEBHOOK_SECRET=

# Optional. Keep the trailing slash.
CXPAY_API_BASE_URL=https://api.cxpay.net/

# Optional. Local port; point the tunnel at 127.0.0.1 on this port.
PORT=4242
